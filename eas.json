{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "cache": {
        "key": "force-rebuild-v9"
      },
      "env": {
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1",
        "EXPO_PUBLIC_API_URL": "https://erebus.nammu-tech.com",
        "EXPO_PUBLIC_REVENUECAT_IOS_API_KEY": "appl_fefLlLgUXEoGoEuvOLZDMabRenk",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY": "goog_OPCPYAKwmwJvSQdpYqlgyoobrUy",
        "EXPO_PUBLIC_REVENUECAT_TEST_API_KEY": "test_mKtTuejTqKLKfDoMVBaMdoDMtbI"
      }
    },
    "production": {
      "ios": {
        "credentialsSource": "local"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://erebusapp.nammu-tech.com",
        "EXPO_PUBLIC_REVENUECAT_IOS_API_KEY": "appl_fefLlLgUXEoGoEuvOLZDMabRenk",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY": "goog_OPCPYAKwmwJvSQdpYqlgyoobrUy",
        "EXPO_PUBLIC_REVENUECAT_TEST_API_KEY": "test_mKtTuejTqKLKfDoMVBaMdoDMtbI"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6780519891",
        "ascApiKeyPath": "./asc-api-key.p8",
        "ascApiKeyIssuerId": "${ASC_ISSUER_ID}",
        "ascApiKeyId": "${ASC_KEY_ID}"
      }
    }
  }
}
