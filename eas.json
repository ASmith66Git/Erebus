{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "cache": {
        "key": "force-rebuild-v6"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://expo-erebus--anthony606.replit.app"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://erebus.nammu-tech.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6758239541"
      }
    }
  }
}
