# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real keys.
# Required for Xcode Archive / local Metro builds (these are device-side, not server-side).
#
# RevenueCat — public app-specific keys from RC Dashboard → API Keys → App-specific
# (NOT the secret API key, which is server-side only)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=

# Google Maps — from Google Cloud Console → Credentials
# Both are device-side: iOS native SDK key (build-time) + JS map component key (runtime)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# API URL — optional, defaults to https://erebusapp.nammu-tech.com
# EXPO_PUBLIC_API_URL=https://erebusapp.nammu-tech.com
