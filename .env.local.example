# Copy this file to .env.local and fill in the values for local Xcode/Mac builds.
# .env.local is gitignored — never commit real keys.
#
# ── WHERE EACH KEY IS NEEDED ──────────────────────────────────────────────────
#
#  EXPO_PUBLIC_* keys are baked into the JS bundle at build time.
#  They must be set in TWO places:
#    1. .env.local       → for Xcode Archive / local Metro builds (this file)
#    2. Render env vars  → for the PWA build (Render dashboard → Environment tab)
#
#  Non-EXPO_PUBLIC keys (e.g. GOOGLE_MAPS_IOS_API_KEY) are native-only;
#  only needed here in .env.local, not on Render.
#
# ─────────────────────────────────────────────────────────────────────────────

# RevenueCat — public app-specific keys (RC Dashboard → API Keys → App-specific)
# NOT the secret API key (that is server-side only, lives in Render env vars)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=

# Google Maps
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY → also needed as a Render env var for PWA maps
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=   # native iOS SDK only, not used in PWA

# API URL — optional, defaults to https://erebusapp.nammu-tech.com
# EXPO_PUBLIC_API_URL=https://erebusapp.nammu-tech.com
